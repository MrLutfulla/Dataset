# Telegram Bot Token (BotFather dan olingan token)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Bitta sessiyada nechta matn o'qitilishi (default: 20 ta buyruq)
SESSION_BATCH_SIZE=20

# SQLite ma'lumotlar bazasi fayl nomi
DB_PATH=dataset.db

# Administratorlar Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789
